# Optional: enables interactive Google Maps. Without it, a built-in map preview is shown.
VITE_GOOGLE_MAPS_API_KEY=

# Accept any 12-digit Aadhaar (checksum becomes a warning). Keep false in production.
VITE_AADHAAR_DEMO_MODE=false

# Backend API base URL
# VITE_API_URL=http://localhost:8000/api/v1
VITE_API_URL=http://192.168.1.4:8000/api/v1
