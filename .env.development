# Loaded only by `npm run dev` (never by `npm run build`).
# Demo mode: accept any 12-digit Aadhaar starting 2-9; a failed UIDAI checksum is shown as a warning instead of an error.
VITE_AADHAAR_DEMO_MODE=true
# Backend API (FastAPI) on the shared Mac. Start it with: uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
# VITE_API_URL=http://localhost:8000/api/v1
VITE_API_URL=http://192.168.1.4:8000/api/v1
